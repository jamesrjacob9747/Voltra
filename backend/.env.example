# Copy to .env and fill in. Never commit .env.

# Local SQLite by default (fast, works offline).
# For Supabase: Connect > Session pooler > copy the URI as-is (postgresql:// is fine) and put your
# database password in it. Use the pooler, not "Direct connection" (that one is IPv6-only).
DATABASE_URL=sqlite:///./voltra.db
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Bookings, "today" and peak pricing use wall-clock time in this zone, even on a UTC server.
TIMEZONE=Asia/Kolkata

# Plug driver: "simulated" now; "shelly" later when the hardware arrives
PLUG_MODE=simulated

# Demo speed multiplier for simulated energy (1 = real time). Say it out loud in the demo.
DEMO_SPEED=30

# Platform fee in basis points (1500 = 15%)
PLATFORM_FEE_BPS=1500
# ChargeSure credit in paise (2000 = Rs 20)
CHARGESURE_CREDIT_PAISE=2000
# A charger is offline after this many seconds without a heartbeat
HEARTBEAT_TIMEOUT_S=30

# Razorpay test mode. Leave empty to use the demo-payment fallback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Demo controls: /admin/* (charger on/off, reset) and the demo payment.
# Set to false on any deployment that isn't a demo.
DEMO_ENDPOINTS=true
# On a hosted server, set a long random value. The demo controls then need it in the
# X-Admin-Token header; build the app with --dart-define=ADMIN_TOKEN=... to send it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=


RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret